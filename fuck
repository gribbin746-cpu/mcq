let i=0,answered=[],chosen=[];
const app=document.getElementById('app');
function modList(){const s=[];Q.forEach(q=>{if(!s.includes(q.m))s.push(q.m);});return s;}
function firstIndexOf(m){return Q.findIndex(q=>q.m===m);}
function render(){
  if(i>=Q.length)return summary();
  const q=Q[i];const locked=answered[i]!==undefined;
  app.innerHTML=header()+jump()+`
    <div class="qcard">
      <span class="tag">${q.m} \u00b7 ${q.t}</span>
      <p class="stem">${i+1}. ${q.s}</p>
      <div id="opts">
        ${q.o.map((opt,idx)=>{let cls='opt';if(locked){if(idx===q.a)cls+=' right';else if(idx===chosen[i])cls+=' wrong';}return `<button class="${cls}" ${locked?'disabled':''} onclick="pick(${idx})"><b>${'ABCDE'[idx]}</b>${opt}</button>`;}).join('')}
      </div>
      ${locked?explain(q,i):''}
      <div class="nav">
        ${i>0?`<button class="btn ghost" onclick="prev()">Back</button>`:''}
        ${locked?`<button class="btn" onclick="next()">${i===Q.length-1?'See results':'Next'}</button>`:`<span style="color:var(--muted);font-size:13px">Select an answer</span>`}
        <span class="count">${i+1} / ${Q.length}</span>
      </div>
    </div>`;
}
function explain(q,idx){const correct=chosen[idx]===q.a;return `<div class="exp"><span class="verdict ${correct?'v-right':'v-wrong'}">${correct?'Correct.':'Not quite. Answer: '+'ABCDE'[q.a]+'.'}</span> ${q.e}</div>`;}
function jump(){return `<div class="jump"><span>Jump to:</span>${modList().map(m=>`<button onclick="goto('${m.replace(/'/g,"\\'")}')">${m}</button>`).join('')}</div>`;}
function goto(m){const idx=firstIndexOf(m);if(idx>=0){i=idx;render();window.scrollTo({top:0,behavior:'smooth'});}}
function header(){
  const done=answered.filter(x=>x!==undefined).length;
  const correct=answered.filter((x,k)=>x!==undefined&&chosen[k]===Q[k].a).length;
  const pct=done?Math.round(correct/done*100):0;
  return `<h1>MEDI4001 Hard Bank</h1>
    <p class="sub">Modules 1\u20134 \u00b7 ${Q.length} questions \u00b7 Level 5\u20136 reasoning \u00b7 Australian guidelines</p>
    <svg class="ecg" viewBox="0 0 760 26" preserveAspectRatio="none"><path d="M0 13 H120 l8 0 l4 -9 l5 18 l4 -9 H300 l8 0 l4 -9 l5 18 l4 -9 H520 l8 0 l4 -9 l5 18 l4 -9 H760" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
    <div class="bar"><i style="width:${i/Q.length*100}%"></i></div>
    <div class="meta"><span>Progress</span><span class="mono">${done} answered \u00b7 ${pct}% correct so far</span></div>`;
}
function pick(idx){if(answered[i]!==undefined)return;chosen[i]=idx;answered[i]=true;render();window.scrollTo({top:0,behavior:'smooth'});}
function next(){i++;render();window.scrollTo({top:0,behavior:'smooth'});}
function prev(){i--;render();window.scrollTo({top:0,behavior:'smooth'});}
function summary(){
  const byMod={};Q.forEach((q,k)=>{byMod[q.m]=byMod[q.m]||{c:0,n:0};byMod[q.m].n++;if(chosen[k]===q.a)byMod[q.m].c++;});
  const correct=Q.filter((q,k)=>chosen[k]===q.a).length;const pct=Math.round(correct/Q.length*100);
  const weak=Q.filter((q,k)=>chosen[k]!==q.a).map(q=>`${q.m.replace('Module ','M')}: ${q.t}`);
  app.innerHTML=`<h1>Results</h1>
    <svg class="ecg" viewBox="0 0 760 26" preserveAspectRatio="none"><path d="M0 13 H120 l8 0 l4 -9 l5 18 l4 -9 H300 l8 0 l4 -9 l5 18 l4 -9 H520 l8 0 l4 -9 l5 18 l4 -9 H760" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
    <div class="summary">
      <div class="score">${correct}<small> / ${Q.length} \u00b7 ${pct}%</small></div>
      <div class="mods">${Object.entries(byMod).map(([m,v])=>{const p=Math.round(v.c/v.n*100);return `<div class="modrow"><span class="nm">${m}</span><span class="bar" style="flex:0 0 140px"><i style="width:${p}%"></i></span><span class="pct mono">${v.c}/${v.n}</span></div>`;}).join('')}</div>
      <div class="weak">${weak.length?`<h3>Revisit before Friday</h3><ul>${weak.map(w=>`<li>${w}</li>`).join('')}</ul>`:`<p class="nogap">No gaps. Strong across Modules 1\u20134 at this difficulty.</p>`}</div>
      <div class="nav" style="margin-top:20px"><button class="btn" onclick="restart()">Retake</button></div>
    </div>`;
  window.scrollTo({top:0,behavior:'smooth'});
}
function restart(){i=0;answered=[];chosen=[];render();}
render();
</script>
